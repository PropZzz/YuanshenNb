# Go 服务端运行配置（P1）
APP_ENV=development
SERVER_ADDR=:8080
DATABASE_URL=postgres://shixu:shixu_dev_password@127.0.0.1:5432/shixu_v2?sslmode=disable
JWT_SECRET=change-me-dev-secret-at-least-32-bytes
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=336h
WS_TICKET_TTL=30s
MAX_REQUEST_BODY_BYTES=2097152

# Web 工作台配置（P3）
# 本地开发默认保持 VITE_API_BASE_URL 留空，使请求通过同源 /api 走 Vite 代理，避免 HttpOnly Cookie 跨源丢失
VITE_API_PROXY_TARGET=http://localhost:8080
# VITE_API_BASE_URL=

# Android 模拟器调试默认后端地址（P4，宿主机回环）
ANDROID_API_BASE_URL=http://10.0.2.2:8080/
